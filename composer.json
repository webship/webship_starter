{
    "name": "drupal/webship_starter",
    "type": "drupal-recipe",
    "description": "The Webship site template: a site to manage software, with documentation, products and releases, a newsletter and social sharing. Built with the UI Suite UIkit theme (UIkit and HTMX) on top of Drupal and Display Builder. No Canvas, no Layout Builder.",
    "homepage": "https://www.drupal.org/project/webship_starter",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Webship",
            "homepage": "https://webship.co",
            "role": "Maintainer"
        }
    ],
    "keywords": ["Drupal", "recipe", "Display Builder", "UI Suite", "UIkit", "starter", "Webship"],
    "require": {
        "drupal/core": "^11.4 || ^12",
        "drupal/ui_suite_uikit": "^1.0",
        "drupal/webadmin": "^12.0",
        "drupal/webai": "^12.0",
        "drupal/webassets": "^12.0",
        "drupal/webconfig": "^12.0",
        "drupal/webdash": "^1.0",
        "drupal/webdev": "^12.0",
        "drupal/webdoc": "^12.0",
        "drupal/webeditor": "^12.0",
        "drupal/webnewsletter": "^12.0",
        "drupal/webpage": "^12.0",
        "drupal/webpatches": "^12.0",
        "drupal/webreleases": "^12.0",
        "drupal/websecurity": "^12.0",
        "drupal/webseo": "^12.0",
        "drupal/webshare": "2.0.x-dev"
    }
}
